import java.util.Scanner;

public class OnlineExamSystem {

    static Scanner sc = new Scanner(System.in);

    static String[] questions = {
        "1. Which language is mainly used for Android development?",
        "2. Which keyword is used to create a class in Java?",
        "3. Which data type stores true or false?",
        "4. Which method is the entry point of a Java program?",
        "5. Which collection does not allow duplicate elements?"
    };

    static String[][] options = {
        {"A. Java", "B. HTML", "C. SQL", "D. CSS"},
        {"A. object", "B. class", "C. new", "D. create"},
        {"A. int", "B. char", "C. boolean", "D. float"},
        {"A. start()", "B. run()", "C. main()", "D. execute()"},
        {"A. List", "B. ArrayList", "C. Set", "D. LinkedList"}
    };

    static char[] answers = {'A', 'B', 'C', 'C', 'C'};

    public static void main(String[] args) {

        System.out.println("================================");
        System.out.println("       ONLINE EXAM SYSTEM");
        System.out.println("================================");

        System.out.print("Enter your name: ");
        String name = sc.nextLine();

        System.out.println("\nWelcome, " + name + "!");
        System.out.println("You have 5 questions.");
        System.out.println("Each question carries 1 mark.\n");

        int score = 0;

        for (int i = 0; i < questions.length; i++) {

            System.out.println(questions[i]);

            for (String option : options[i]) {
                System.out.println(option);
            }

            System.out.print("Enter your answer (A/B/C/D): ");
            char userAnswer = Character.toUpperCase(sc.next().charAt(0));

            if (userAnswer == answers[i]) {
                score++;
                System.out.println("Correct!\n");
            } else {
                System.out.println(
                    "Wrong! Correct answer: " + answers[i] + "\n"
                );
            }
        }

        double percentage = (score / 5.0) * 100;

        System.out.println("================================");
        System.out.println("             RESULT");
        System.out.println("================================");
        System.out.println("Student Name : " + name);
        System.out.println("Total Marks  : 5");
        System.out.println("Score        : " + score);
        System.out.println("Percentage   : " + percentage + "%");

        if (percentage >= 80) {
            System.out.println("Grade        : A");
            System.out.println("Result       : PASS");
        } else if (percentage >= 60) {
            System.out.println("Grade        : B");
            System.out.println("Result       : PASS");
        } else if (percentage >= 40) {
            System.out.println("Grade        : C");
            System.out.println("Result       : PASS");
        } else {
            System.out.println("Grade        : F");
            System.out.println("Result       : FAIL");
        }

        System.out.println("================================");
        System.out.println("Thank you for taking the exam!");
    }
}
